model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","States","Customers","Sellers","Products","Orders","OrderItems","Payments","Reviews"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table Orders
ref table OrderItems
ref table Payments
ref table Reviews
ref table Customers
ref table Sellers
ref table Products
ref table States
ref table Date

ref cultureInfo en-US


/// Sellers. State name/region merged from States in Power Query (no relationship to States to avoid ambiguous paths).
table Sellers

	column SellerId
		dataType: string
		summarizeBy: none
		sourceColumn: SellerId

	column ZipPrefix
		dataType: string
		dataCategory: PostalCode
		summarizeBy: none
		sourceColumn: ZipPrefix

	column City
		dataType: string
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

	column StateCode
		dataType: string
		summarizeBy: none
		sourceColumn: StateCode

	column SellerStateName
		dataType: string
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: SellerStateName

	column SellerRegion
		dataType: string
		summarizeBy: none
		sourceColumn: SellerRegion

	partition Sellers = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "olist_sellers_dataset.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Renamed = Table.RenameColumns(Promoted, {
						{"seller_id", "SellerId"},
						{"seller_zip_code_prefix", "ZipPrefix"},
						{"seller_city", "City"},
						{"seller_state", "StateCode"}
					}),
					Typed = Table.TransformColumnTypes(Renamed, {
						{"SellerId", type text},
						{"ZipPrefix", type text},
						{"City", type text},
						{"StateCode", type text}
					}, "en-US"),
					ProperCity = Table.TransformColumns(Typed, {{"City", Text.Proper, type text}}),
					MergedStates = Table.NestedJoin(ProperCity, {"StateCode"}, States, {"StateCode"}, "St", JoinKind.LeftOuter),
					ExpandedStates = Table.ExpandTableColumn(MergedStates, "St", {"StateName", "Region"}, {"SellerStateName", "SellerRegion"})
				in
					ExpandedStates

	annotation PBI_ResultType = Table


/// Sellers. State name/region merged from States in Power Query (no relationship to States to avoid ambiguous paths).
table Sellers
	lineageTag: 12146fa4-f028-4521-8a25-be7bc286af42

	column SellerId
		dataType: string
		lineageTag: dc9aaf29-ee6f-4efb-92d3-720a88299433
		summarizeBy: none
		sourceColumn: SellerId

	column ZipPrefix
		dataType: string
		lineageTag: 3023eee6-066d-41b7-86af-e7fd5f7e137b
		dataCategory: PostalCode
		summarizeBy: none
		sourceColumn: ZipPrefix

	column City
		dataType: string
		lineageTag: 9b560528-8697-4205-98da-2ba6c0a3f7aa
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

	column StateCode
		dataType: string
		lineageTag: 9aa57d50-c1a6-4fed-8c84-59a347b1f263
		summarizeBy: none
		sourceColumn: StateCode

	column SellerStateName
		dataType: string
		lineageTag: 0853f0b8-8c4c-417d-b5f8-ed032b1443aa
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: SellerStateName

	column SellerRegion
		dataType: string
		lineageTag: 0a144cf0-5b29-4722-8f0a-5d138ccf86ae
		summarizeBy: none
		sourceColumn: SellerRegion

	partition Sellers = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "olist_sellers_dataset.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Renamed = Table.RenameColumns(Promoted, {
						{"seller_id", "SellerId"},
						{"seller_zip_code_prefix", "ZipPrefix"},
						{"seller_city", "City"},
						{"seller_state", "StateCode"}
					}),
					Typed = Table.TransformColumnTypes(Renamed, {
						{"SellerId", type text},
						{"ZipPrefix", type text},
						{"City", type text},
						{"StateCode", type text}
					}, "en-US"),
					ProperCity = Table.TransformColumns(Typed, {{"City", Text.Proper, type text}}),
					MergedStates = Table.NestedJoin(ProperCity, {"StateCode"}, States, {"StateCode"}, "St", JoinKind.LeftOuter),
					ExpandedStates = Table.ExpandTableColumn(MergedStates, "St", {"StateName", "Region"}, {"SellerStateName", "SellerRegion"})
				in
					ExpandedStates

	annotation PBI_ResultType = Table


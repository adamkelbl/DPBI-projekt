/// Payments – an order can be paid in several parts (PaymentSequential).
table Payments
	lineageTag: 72a3a9d3-4bb4-4706-99db-1d240b1d8652

	column OrderId
		dataType: string
		isHidden
		lineageTag: 908f63e8-6e9f-4ded-b107-0deb007b9706
		summarizeBy: none
		sourceColumn: OrderId

	column PaymentSequential
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 81b2d444-2fa8-44e7-82e7-ddbc6e8d81c6
		summarizeBy: none
		sourceColumn: PaymentSequential

	column PaymentType
		dataType: string
		lineageTag: 357c4e4a-d55f-4d53-85db-6e62cbf3f9fd
		summarizeBy: none
		sourceColumn: PaymentType

	column Installments
		dataType: int64
		formatString: 0
		lineageTag: 6d18c059-abb9-4262-8a3e-3394bc3d8630
		summarizeBy: none
		sourceColumn: Installments

	column PaymentValue
		dataType: decimal
		formatString: #,0.00
		lineageTag: 26306233-2879-4f7d-8507-32e2c7d94955
		summarizeBy: sum
		sourceColumn: PaymentValue

	partition Payments = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "olist_order_payments_dataset.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Renamed = Table.RenameColumns(Promoted, {
						{"order_id", "OrderId"},
						{"payment_sequential", "PaymentSequential"},
						{"payment_type", "PaymentTypeCode"},
						{"payment_installments", "Installments"},
						{"payment_value", "PaymentValue"}
					}),
					Typed = Table.TransformColumnTypes(Renamed, {
						{"OrderId", type text},
						{"PaymentSequential", Int64.Type},
						{"PaymentTypeCode", type text},
						{"Installments", Int64.Type},
						{"PaymentValue", Currency.Type}
					}, "en-US"),
					TypeMap = [
						credit_card = "Kreditní karta",
						boleto = "Boleto",
						voucher = "Voucher",
						debit_card = "Debetní karta",
						not_defined = "Neurčeno"
					],
					AddType = Table.AddColumn(Typed, "PaymentType", each Record.FieldOrDefault(TypeMap, [PaymentTypeCode], [PaymentTypeCode]), type text),
					Final = Table.RemoveColumns(AddType, {"PaymentTypeCode"})
				in
					Final

	annotation PBI_ResultType = Table


/// One row per customer_id (= per order). CustomerUniqueId identifies the real person.
table Customers
	lineageTag: 3aafa84c-ab6d-4a22-a6e7-7c0ad5dcbf23

	column CustomerId
		dataType: string
		isHidden
		lineageTag: 232812a2-1249-4ca8-adaf-46bc80228789
		summarizeBy: none
		sourceColumn: CustomerId

	column CustomerUniqueId
		dataType: string
		isHidden
		lineageTag: e2e8fed0-3e47-4ec2-aefe-757576032620
		summarizeBy: none
		sourceColumn: CustomerUniqueId

	column ZipPrefix
		dataType: string
		lineageTag: 18bb6490-406b-49c8-b296-d11bb0fc2ecb
		dataCategory: PostalCode
		summarizeBy: none
		sourceColumn: ZipPrefix

	column City
		dataType: string
		lineageTag: 674172a5-234f-48a1-8b9d-c8f8d72961c5
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

	column StateCode
		dataType: string
		isHidden
		lineageTag: 29191740-97ba-4714-875d-d33a4ec43cb3
		summarizeBy: none
		sourceColumn: StateCode

	partition Customers = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "olist_customers_dataset.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Renamed = Table.RenameColumns(Promoted, {
						{"customer_id", "CustomerId"},
						{"customer_unique_id", "CustomerUniqueId"},
						{"customer_zip_code_prefix", "ZipPrefix"},
						{"customer_city", "City"},
						{"customer_state", "StateCode"}
					}),
					Typed = Table.TransformColumnTypes(Renamed, {
						{"CustomerId", type text},
						{"CustomerUniqueId", type text},
						{"ZipPrefix", type text},
						{"City", type text},
						{"StateCode", type text}
					}, "en-US"),
					ProperCity = Table.TransformColumns(Typed, {{"City", Text.Proper, type text}})
				in
					ProperCity

	annotation PBI_ResultType = Table


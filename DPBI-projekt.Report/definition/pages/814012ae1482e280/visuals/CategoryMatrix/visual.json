{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "CategoryMatrix",
  "position": {
    "x": 24,
    "y": 400,
    "z": 0,
    "height": 304,
    "width": 740,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Products"
                    }
                  },
                  "Property": "Category"
                }
              },
              "queryRef": "Products.Category",
              "nativeQueryRef": "Category",
              "active": true,
              "displayName": "Kategorie"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Category Rank"
                }
              },
              "queryRef": "_Measures.Category Rank",
              "nativeQueryRef": "Category Rank",
              "displayName": "Pořadí"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Revenue"
                }
              },
              "queryRef": "_Measures.Revenue",
              "nativeQueryRef": "Revenue",
              "displayName": "Tržby"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Items Sold"
                }
              },
              "queryRef": "_Measures.Items Sold",
              "nativeQueryRef": "Items Sold",
              "displayName": "Prodané kusy"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Average Item Price"
                }
              },
              "queryRef": "_Measures.Average Item Price",
              "nativeQueryRef": "Average Item Price",
              "displayName": "Ø cena položky"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Freight Share"
                }
              },
              "queryRef": "_Measures.Freight Share",
              "nativeQueryRef": "Freight Share",
              "displayName": "Podíl dopravy"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Late Rate"
                }
              },
              "queryRef": "_Measures.Late Rate",
              "nativeQueryRef": "Late Rate",
              "displayName": "Podíl pozdních doručení"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Avg Review Score"
                }
              },
              "queryRef": "_Measures.Avg Review Score",
              "nativeQueryRef": "Avg Review Score",
              "displayName": "Ø hodnocení"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Measures"
                  }
                },
                "Property": "Revenue"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "objects": {
      "columnFormatting": [
        {
          "properties": {}
        },
        {
          "properties": {
            "dataBars": {
              "positiveColor": {
                "solid": {
                  "color": {
                    "expr": {
                      "Literal": {
                        "Value": "'good'"
                      }
                    }
                  }
                }
              },
              "negativeColor": {
                "solid": {
                  "color": {
                    "expr": {
                      "Literal": {
                        "Value": "'bad'"
                      }
                    }
                  }
                }
              },
              "axisColor": {
                "solid": {
                  "color": {
                    "expr": {
                      "Literal": {
                        "Value": "'#FFFFFF'"
                      }
                    }
                  }
                }
              },
              "reverseDirection": {
                "expr": {
                  "Literal": {
                    "Value": "false"
                  }
                }
              },
              "hideText": {
                "expr": {
                  "Literal": {
                    "Value": "false"
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Revenue"
          }
        }
      ],
      "values": [
        {
          "properties": {}
        },
        {
          "properties": {
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Measure": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "_Measures"
                        }
                      },
                      "Property": "Review Color"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ],
            "metadata": "_Measures.Avg Review Score"
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Výkon kategorií'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "StateMap",
  "position": {
    "x": 24,
    "y": 192,
    "z": 0,
    "height": 512,
    "width": 600,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "States"
                    }
                  },
                  "Property": "StateName"
                }
              },
              "queryRef": "States.StateName",
              "nativeQueryRef": "StateName",
              "active": true,
              "displayName": "Stát"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Revenue"
                }
              },
              "queryRef": "_Measures.Revenue",
              "nativeQueryRef": "Revenue",
              "displayName": "Tržby"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Order Count"
                }
              },
              "queryRef": "_Measures.Order Count",
              "nativeQueryRef": "Order Count",
              "displayName": "Objednávky"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Average Order Value"
                }
              },
              "queryRef": "_Measures.Average Order Value",
              "nativeQueryRef": "Average Order Value",
              "displayName": "Průměrná objednávka"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "On-Time Rate"
                }
              },
              "queryRef": "_Measures.On-Time Rate",
              "nativeQueryRef": "On-Time Rate",
              "displayName": "Doručeno včas"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Avg Delivery Days"
                }
              },
              "queryRef": "_Measures.Avg Delivery Days",
              "nativeQueryRef": "Avg Delivery Days",
              "displayName": "Ø doba doručení (dny)"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Avg Review Score"
                }
              },
              "queryRef": "_Measures.Avg Review Score",
              "nativeQueryRef": "Avg Review Score",
              "displayName": "Ø hodnocení"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Measures"
                  }
                },
                "Property": "Revenue"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Measure": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "_Measures"
                        }
                      },
                      "Property": "On-Time Color"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ]
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Tržby podle státu zákazníka'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Barva = podíl doručení včas (zelená ≥ 92 %, žlutá ≥ 85 %, jinak červená)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
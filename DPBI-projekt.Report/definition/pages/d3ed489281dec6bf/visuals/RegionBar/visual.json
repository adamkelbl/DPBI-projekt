{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "RegionBar",
  "position": {
    "x": 840,
    "y": 192,
    "z": 0,
    "height": 320,
    "width": 416,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "States"
                    }
                  },
                  "Property": "Region"
                }
              },
              "queryRef": "States.Region",
              "nativeQueryRef": "Region",
              "active": true,
              "displayName": "Region"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Revenue"
                }
              },
              "queryRef": "_Measures.Revenue",
              "nativeQueryRef": "Revenue",
              "displayName": "Tržby"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Order Count"
                }
              },
              "queryRef": "_Measures.Order Count",
              "nativeQueryRef": "Order Count",
              "displayName": "Objednávky"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Customer Count"
                }
              },
              "queryRef": "_Measures.Customer Count",
              "nativeQueryRef": "Customer Count",
              "displayName": "Zákazníci"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "On-Time Rate"
                }
              },
              "queryRef": "_Measures.On-Time Rate",
              "nativeQueryRef": "On-Time Rate",
              "displayName": "Doručeno včas"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Avg Review Score"
                }
              },
              "queryRef": "_Measures.Avg Review Score",
              "nativeQueryRef": "Avg Review Score",
              "displayName": "Ø hodnocení"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Measures"
                  }
                },
                "Property": "Revenue"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Tržby podle regionu zákazníka'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}